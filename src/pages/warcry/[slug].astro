---
import Recipes from '../../layouts/Recipe.astro';

import { getCollection } from 'astro:content';
import PaintSwatch from '../../components/paint-swatch/PaintSwatch.astro';

export async function getStaticPaths() {
  const recipeEntries = await getCollection('warcry');

  return recipeEntries.map((entry) => ({
    params: {
      slug: entry.slug,
    },
    props: {
      entry,
      title: entry.data.title,
      description: entry.data.description,
      paints: entry.data.paints,
    },
  }));
}



const { entry, title, description, paints } = Astro.props;
const { Content } = await entry.render();
---

<Recipes title={title} description={description}>
  <Content />

  <PaintSwatch swatches={paints}></PaintSwatch>
</Recipes>
