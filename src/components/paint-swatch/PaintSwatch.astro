---
import { getPaints } from '../../controllers/paints';

interface Props {
  swatches: string[]
}

const { swatches } = Astro.props;

const paints = await getPaints(swatches);
---

<section class="paint-swatches" data-test="paint-swatch">
  <h2>Paints Used</h2>

  {paints.map((swatch) => (
    <div class="swatch-card" data-test="swatch-card">
      <span data-test="swatch" class="swatch" style=`background: ${swatch.colour}`></span>
      <p class="paint-info">
        {swatch.id && swatch.id}
        {swatch.id && <br />}
        {swatch.name}
      </p>
    </div>
  ))}
</section>

<style>
  .paint-swatches {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding: 0 3.5625rem;
      margin-bottom: 2.25rem;
      gap: 1rem 1.5rem;
      max-width: 16.625rem;
      margin-inline: auto;

      h2 {
          text-align: center;
          grid-column: span 2;
          font-size: var(--section-title-size);
          font-weight: normal;
          font-family: var(--section-title-font);
          margin: 0;
      }

      .swatch-card {
          display: grid;
          grid-template-rows: 2rem 1fr;
          border: 1px solid rgb(224, 230, 236);
          text-align: center;
      }

      .paint-info {
          align-self: center;
          margin: .5rem 0;
          padding: 0 .375rem;
      }
  }
</style>
